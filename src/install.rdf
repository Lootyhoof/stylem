<?xml version="1.0"?>
<RDF xmlns="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:em="http://www.mozilla.org/2004/em-rdf#">
  <Description rdf:about="urn:mozilla:install-manifest">
    <em:id>{503a85e3-84c9-40e5-b98e-98e62085837f}</em:id>
    <em:name>Stylem</em:name>
    <em:version>3.0.0b1</em:version>
    <em:description>Restyle the web with Stylem, a UserCSS-compatible user styles manager for UXP-based applications.</em:description>
    <em:creator>Lootyhoof</em:creator>
    <em:iconURL>chrome://stylem/skin/32.svg</em:iconURL>
    <em:multiprocessCompatible>false</em:multiprocessCompatible>
    <em:type>2</em:type>

    <!-- Pale Moon -->
    <em:targetApplication>
      <Description>
        <em:id>{8de7fcbb-c55c-4fbe-bfc5-fc555c87dbc4}</em:id>
        <em:minVersion>28.0</em:minVersion>
        <em:maxVersion>33.*</em:maxVersion>
      </Description>
    </em:targetApplication>

    <!-- Basilisk / Firefox -->
    <em:targetApplication>
      <Description>
        <em:id>{ec8030f7-c20a-464f-9b0e-13a3a9e97384}</em:id>
        <em:minVersion>52.0</em:minVersion>
        <em:maxVersion>57.*</em:maxVersion>
      </Description>
    </em:targetApplication>

    <!-- Epyrus -->
    <em:targetApplication>
      <Description>
        <em:id>{29877c1d-27df-4421-9a79-382c31470151}</em:id>
        <em:minVersion>1.0</em:minVersion>
        <em:maxVersion>2.*</em:maxVersion>
      </Description>
    </em:targetApplication>

    <!-- SeaMonkey -->
    <em:targetApplication>
      <Description>
        <em:id>{92650c4d-4b8e-4d2a-b7eb-24ecf4f6b63a}</em:id>
        <em:minVersion>2.49</em:minVersion>
        <em:maxVersion>2.*</em:maxVersion>
      </Description>
    </em:targetApplication>

  </Description>
</RDF>
